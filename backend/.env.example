WIKIPEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
FRONTEND_ORIGIN=http://localhost:5173

LLM_API_KEY=
LLM_MODEL=

# "live" connects to the real Wikimedia stream; "replay" paces through
# sample_events.jsonl instead, for local dev/testing without network access.
STREAM_SOURCE=live
REPLAY_SPEED=1.0
REPLAY_LOOP=true
